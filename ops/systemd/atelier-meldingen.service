[Unit]
Description=Leeratelier: bezoekersmeldingen omzetten in voorstellen tot paginaverbetering
Documentation=file:///mnt/nvme/workspaces/leeratelier/ops/meldingen-verwerken.py
After=network-online.target llama-klasmodel.service

[Service]
Type=oneshot
User=bob
WorkingDirectory=/mnt/nvme/workspaces/leeratelier
# Bewust ZONDER --toepassen. Het script kan wijzigingen doorvoeren, maar het
# oordeel van een lokaal model bleek daar niet goed genoeg voor: bij een
# lezersvraag stelde het voor om juist de link te schrappen die de lezer zocht.
# Zie spec/05-besluitenlog.md V38. Dit draait dus als voorsteller, niet als redacteur.
ExecStart=/usr/bin/python3 ops/meldingen-verwerken.py
Nice=10

[Install]
WantedBy=multi-user.target
