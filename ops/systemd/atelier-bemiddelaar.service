# WP-05. Naar /etc/systemd/system/.
[Unit]
Description=Leeratelier bemiddelaar (poort 8794)
After=network-online.target llama-klasmodel.service
Wants=network-online.target

[Service]
Type=simple
User=bob
WorkingDirectory=/mnt/nvme/workspaces/leeratelier
EnvironmentFile=-/mnt/nvme/workspaces/leeratelier/.env
ExecStart=/usr/bin/python3 -m uvicorn gateway.main:app --host 127.0.0.1 --port 8794
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
