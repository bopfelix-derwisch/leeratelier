# WP-04. Klasmodel, permanent. Naar /etc/systemd/system/.
# Meet het geheugen voor en na de eerste start: 61 GB unified, circa 30 GB al in gebruik.
[Unit]
Description=llama.cpp klasmodel voor het leeratelier (poort 8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bob
# Model gekozen in WP-03 (besluit B17). --reasoning-budget 0 is niet optioneel:
# Qwen3-8B is hybride en lekt anders <think>-blokken naar de bezoeker (vondst V7).
# --ctx-size is op build 8117 PER SLOT, niet het totaal -- toets dat bij WP-04 (vondst V1).
ExecStart=/usr/local/bin/llama-server \
  --model /mnt/nvme/nvme/models/qwen3-8b/Qwen3-8B-Q4_K_M.gguf \
  --host 127.0.0.1 --port 8081 \
  --ctx-size 4096 --parallel 4 \
  --reasoning-budget 0 \
  --n-gpu-layers 99 --threads 4
Restart=always
RestartSec=10
# Het atelier is permanent open en onbewaakt. Nooit opgeven.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
